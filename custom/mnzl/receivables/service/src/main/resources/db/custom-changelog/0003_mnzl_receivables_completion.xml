<addUniqueConstraint tableName="m_mnzl_r_hel_reporting_registration" columnNames="product_id" constraintName="uq_r_hel_reporting_product"/>
<addUniqueConstraint tableName="m_mnzl_r_hel_reporting_registration" columnNames="scope_key" constraintName="uq_r_hel_reporting_scope"/>
<addUniqueConstraint tableName="m_mnzl_r_hel_reporting_member" columnNames="capture_key,loan_id" constraintName="uq_r_hel_reporting_member"/>
<addUniqueConstraint tableName="m_mnzl_r_hel_reporting_journal" columnNames="capture_key,native_journal_id" constraintName="uq_r_hel_reporting_journal"/>
</changeSet>
</databaseChangeLog>
