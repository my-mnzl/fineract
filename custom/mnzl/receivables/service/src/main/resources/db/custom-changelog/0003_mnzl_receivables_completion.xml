<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">
<changeSet id="mnzl-receivables-consumed-intent-3" author="mnzl">
<createTable tableName="m_mnzl_r_consumed_intent">
<column name="record_key" type="VARCHAR(64)"><constraints primaryKey="true" nullable="false"/></column>
<column name="scope_key" type="VARCHAR(64)"><constraints nullable="false"/></column>
<column name="original_idempotency_hash" type="VARCHAR(64)"><constraints nullable="false"/></column>
<column name="original_payload_hash" type="VARCHAR(64)"><constraints nullable="false"/></column>
<column name="original_request_json" type="CLOB"><constraints nullable="false"/></column>
<column name="continuation_operation_key" type="VARCHAR(64)"><constraints nullable="false"/></column>
<column name="continuation_payload_hash" type="VARCHAR(64)"><constraints nullable="false"/></column>
</createTable>
<addUniqueConstraint tableName="m_mnzl_r_consumed_intent" columnNames="scope_key,original_idempotency_hash" constraintName="uq_r_consumed_intent_idempotency"/>
</changeSet>
<changeSet id="mnzl-receivables-developer-statement-ownership-3" author="mnzl">
<addColumn tableName="m_mnzl_r_state_snapshot"><column name="account_key" type="VARCHAR(64)"/></addColumn>
<addColumn tableName="m_mnzl_r_lot_allocation"><column name="account_key" type="VARCHAR(64)"/></addColumn>
<sql dbms="mysql,mariadb"><![CDATA[
UPDATE m_mnzl_r_state_snapshot s JOIN m_mnzl_r_account a
ON a.scope_key=s.scope_key AND BINARY a.external_id=BINARY JSON_UNQUOTE(JSON_EXTRACT(s.snapshot_json,'$.accountId'))
SET s.account_key=a.record_key WHERE s.subject_kind='LOT';
UPDATE m_mnzl_r_lot_allocation a JOIN m_mnzl_r_event e ON e.operation_key=a.operation_key
JOIN m_mnzl_r_state_snapshot s ON s.event_key=e.record_key AND s.subject_key=a.lot_key AND s.subject_kind='LOT'
SET a.account_key=s.account_key;
]]></sql>
<sql dbms="postgresql"><![CDATA[
UPDATE m_mnzl_r_state_snapshot s SET account_key=a.record_key FROM m_mnzl_r_account a
WHERE a.scope_key=s.scope_key AND a.external_id=CAST(s.snapshot_json AS json)->>'accountId' AND s.subject_kind='LOT';
UPDATE m_mnzl_r_lot_allocation a SET account_key=s.account_key FROM m_mnzl_r_event e,m_mnzl_r_state_snapshot s
WHERE e.operation_key=a.operation_key AND s.event_key=e.record_key AND s.subject_key=a.lot_key AND s.subject_kind='LOT';
]]></sql>
<createIndex tableName="m_mnzl_r_state_snapshot" indexName="ix_r_snapshot_account"><column name="account_key"/><column name="subject_key"/></createIndex>
<createIndex tableName="m_mnzl_r_lot_allocation" indexName="ix_r_lot_allocation_account"><column name="scope_key"/><column name="account_key"/><column name="record_key"/></createIndex>
</changeSet>
<changeSet id="mnzl-receivables-developer-statement-ownership-check-3" author="mnzl">
<preConditions onFail="HALT" onError="HALT">
<sqlCheck expectedResult="0">SELECT COUNT(*) FROM m_mnzl_r_state_snapshot WHERE subject_kind='LOT' AND account_key IS NULL</sqlCheck>
<sqlCheck expectedResult="0">SELECT COUNT(*) FROM m_mnzl_r_lot_allocation WHERE account_key IS NULL</sqlCheck>
</preConditions>
<addNotNullConstraint tableName="m_mnzl_r_lot_allocation" columnName="account_key" columnDataType="VARCHAR(64)"/>
</changeSet>
<changeSet id="mnzl-receivables-developer-impairment-proof-3" author="mnzl">
<addColumn tableName="m_mnzl_r_command"><column name="effect_proof_json" type="CLOB"/></addColumn>
</changeSet>
