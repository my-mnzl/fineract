<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">
    <!--
        Segment snapshots are unhashed measurement state that deserialises strictly into the renamed position record, so
        their one legacy field is renamed in place. Hash-sealed rows (commands, events, journal lines, account terms,
        configuration revisions, period snapshots) keep their bytes and are aliased on read instead.
    -->
    <changeSet id="mnzl-receivables-admin-fee-8" author="mnzl">
        <update tableName="m_mnzl_r_segment">
            <column name="snapshot_json" valueComputed="replace(snapshot_json, '&quot;deferredIntegralFeeMinor&quot;:', '&quot;deferredAdminFeeMinor&quot;:')"/>
            <where>snapshot_json like '%"deferredIntegralFeeMinor":%'</where>
        </update>
    </changeSet>
</databaseChangeLog>
